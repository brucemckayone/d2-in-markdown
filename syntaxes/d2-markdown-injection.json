{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "D2 Markdown Injection",
  "scopeName": "markdown.d2.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#d2-fenced-code-block"
    }
  ],
  "repository": {
    "d2-fenced-code-block": {
      "begin": "(^|\\G)(\\s*)((`{3,})|(~{3,}))\\s*(?i:(d2))(\\s+[^`~]*)?$",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\4|\\5)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "6": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*((`{3,})|~{3,})\\s*$)",
          "contentName": "meta.embedded.block.d2",
          "patterns": [
            { "include": "source.d2" }
          ]
        }
      ]
    }
  }
}
