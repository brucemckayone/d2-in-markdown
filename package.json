{
  "name": "d2-in-markdown",
  "displayName": "D2 in Markdown",
  "description": "Render D2 diagrams in VS Code Markdown preview",
  "version": "0.0.3",
  "publisher": "brucermckay",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "d2",
        "aliases": [
          "D2",
          "d2"
        ],
        "extensions": [
          ".d2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "d2",
        "scopeName": "source.d2",
        "path": "./syntaxes/d2.tmLanguage.json"
      },
      {
        "scopeName": "markdown.d2.codeblock",
        "path": "./syntaxes/d2-markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.d2": "d2"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/d2-zoom.js"
    ],
    "markdown.previewStyles": [
      "./media/d2-zoom.css"
    ],
    "configuration": {
      "title": "D2 in Markdown",
      "properties": {
        "d2InMarkdown.theme": {
          "type": "integer",
          "default": 0,
          "description": "The diagram theme ID. (e.g. 0=Neutral, 1=Neutral Dark, 100=Grape, etc.)"
        },
        "d2InMarkdown.darkTheme": {
          "type": "integer",
          "default": -1,
          "description": "The theme to use when the viewer is in dark mode. Set to -1 to use the same as 'theme'."
        },
        "d2InMarkdown.layout": {
          "type": "string",
          "default": "dagre",
          "enum": [
            "dagre",
            "elk"
          ],
          "description": "The layout engine used."
        },
        "d2InMarkdown.sketch": {
          "type": "boolean",
          "default": false,
          "description": "Render the diagram to look like it was sketched by hand."
        },
        "d2InMarkdown.pad": {
          "type": "integer",
          "default": 100,
          "description": "Pixels padded around the rendered diagram."
        },
        "d2InMarkdown.scale": {
          "type": "number",
          "default": -1,
          "description": "Scale the output. -1 means fit to screen. 1 means original size."
        }
      }
    },
    "commands": [
      {
        "command": "d2.configure",
        "title": "D2: Configure Renderer"
      },
      {
        "command": "d2.formatBlock",
        "title": "D2: Format Diagram Block"
      },
      {
        "command": "d2.exportDiagram",
        "title": "D2: Export Diagram"
      },
      {
        "command": "d2.openPlayground",
        "title": "D2: Open in Playground"
      },
      {
        "command": "d2.openPreview",
        "title": "D2: Open Live Preview"
      },
      {
        "command": "d2.copyError",
        "title": "D2: Copy Error to Clipboard"
      }
    ],
    "codeLens": [
      {
        "language": "markdown",
        "command": ""
      }
    ],
    "snippets": [
      {
        "language": "d2",
        "path": "./snippets.json"
      },
      {
        "language": "markdown",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --minify",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "check": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/markdown-it": "^12.2.3",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.0.0"
  }
}
